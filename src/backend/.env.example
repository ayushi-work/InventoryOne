# ---- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TZ=Asia/Kolkata

# ---- Database -------------------------------------------------------------
POSTGRES_DB=inventoryone
POSTGRES_USER=ayushi
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# ---- Redis / Channels / Celery --------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# Run Celery tasks inline (no worker needed) - ideal for local demos
CELERY_TASK_ALWAYS_EAGER=True

# ---- CORS / frontend ------------------------------------------------------
FRONTEND_URL=http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://inventoryone.example.com

# ---- Application ----------------------------------------------------------
# Echo the OTP back in the API response instead of emailing it
OTP_DEBUG_MODE=True
OTP_TTL_MINUTES=5
THROTTLE_ANON=60/min
THROTTLE_USER=600/min

# ---- Object storage (AWS S3) - optional -----------------------------------
# When unset, files are written to MEDIA_ROOT on local disk
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=ap-south-1

# ---- Firebase Cloud Messaging - optional ----------------------------------
FCM_SERVER_KEY=
FCM_ENDPOINT=https://fcm.googleapis.com/fcm/send

# ---- Google Maps - optional -----------------------------------------------
GOOGLE_MAPS_API_KEY=
